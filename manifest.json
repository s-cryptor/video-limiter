{
  "manifest_version": 3,
  "name": "Video Limiter",
  "version": "1.0.0",
  "description": "Считает время просмотра видео во всех вкладках и блокирует видео после дневного лимита.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Video Limiter",
    "default_popup": "src/popup/popup.html"
  }
}
